APP_ENV=local
RELEASE_ID=dev
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Runtime pooled URL (optional in local). PostgreSQL only — SQLite is rejected.
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/ai_dating

# Direct URL for Alembic (optional in local).
# DATABASE_DIRECT_URL=postgresql://user:password@127.0.0.1:5432/ai_dating

# ClickHouse HTTP (optional in local API; required for ai-dating-relay).
# CLICKHOUSE_URL=http://127.0.0.1:8123
# CLICKHOUSE_DATABASE=ai_dating
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=

# Local-password auth binds loopback only.
# BIND_HOST=127.0.0.1
# SESSION_TTL_SECONDS=86400

# Local LLM stand-in. DS Lab (paid, rubles) wins over OpenRouter.
# The same DSLAB_API_KEY is used for chat extraction and embeddings.
# Without a key, both use the local fake unless Yandex / EMBEDDING_* is set.
# DSLAB_API_KEY=
# DSLAB_MODEL=gemini-2.5-flash-lite
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free
# EXTRACTION_TIMEOUT_SECONDS=20

# Retrieval embeddings. Default: DS Lab gte-base (768-d, cheapest on the catalog).
# EMBEDDING_MODEL=gte-base
# Optional host/key override (production GigaChat). Unset uses DSLAB_API_KEY.
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_TIMEOUT_SECONDS=15

# Yandex AI Studio (production generation provider). Used when DS Lab/OpenRouter are unset.
# YANDEX_AI_BASE_URL=https://llm.api.cloud.yandex.net/v1
# YANDEX_AI_API_KEY=
# YANDEX_AI_FOLDER_ID=
# YANDEX_AI_MODEL=yandexgpt-lite/latest
# EXTRACTION_PROMPT_VERSION=extract-facts-v3
# EXTRACTION_TIMEOUT_SECONDS=8
# EXTRACTION_MAX_ATTEMPTS=3
# Object storage. Local filesystem is the default prototype backend.
# Staging/production use S3-compatible Yandex Object Storage.
# OBJECT_STORAGE_BACKEND=local
# OBJECT_STORAGE_PATH=
# MEDIA_AUTO_APPROVE=true
# MESSAGE_AUTO_APPROVE=true
# MESSAGE_RATE_PER_MINUTE=20
# MESSAGE_RATE_PER_DAY=200
# PHOTO_MAX_BYTES=10485760
# UPLOAD_INTENT_TTL_SECONDS=900
# MEDIA_URL_TTL_SECONDS=300
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_ACCESS_KEY=
# OBJECT_STORAGE_SECRET_KEY=
# OBJECT_STORAGE_REGION=ru-central1
# MEDIA_SIGNING_SECRET=local-media-signing

# Bounded LLM rerank stays off until a passing human-eval manifest matches versions.
# RERANK_ENABLED=false
# RERANK_TIMEOUT_SECONDS=3
# RERANK_MANIFEST_PATH=
