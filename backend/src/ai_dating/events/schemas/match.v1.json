{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "match.v1.json",
  "allOf": [
    {
      "$ref": "envelope.json"
    },
    {
      "type": "object",
      "properties": {
        "event_name": {
          "const": "match"
        },
        "schema_version": {
          "const": 1
        },
        "owner": {
          "const": "matching"
        },
        "privacy_classification": {
          "const": "product_pseudonymous"
        },
        "properties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "const": "reciprocal_like"
            }
          }
        },
        "actor_account_id": {
          "type": "string",
          "format": "uuid"
        },
        "subject_account_id": {
          "type": "string",
          "format": "uuid"
        },
        "recommendation_batch_id": {
          "type": "string",
          "format": "uuid"
        },
        "recommendation_item_id": {
          "type": "string",
          "format": "uuid"
        },
        "match_id": {
          "type": "string",
          "format": "uuid"
        },
        "conversation_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    }
  ]
}
