{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "onboarding_step_completed.v1.json",
  "allOf": [
    {
      "$ref": "envelope.json"
    },
    {
      "type": "object",
      "properties": {
        "event_name": {
          "const": "onboarding_step_completed"
        },
        "schema_version": {
          "const": 1
        },
        "owner": {
          "const": "onboarding"
        },
        "privacy_classification": {
          "const": "product_pseudonymous"
        },
        "properties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "flow_version",
            "step_code",
            "profile_version",
            "preferences_version"
          ],
          "properties": {
            "flow_version": {
              "type": "string",
              "minLength": 1
            },
            "step_code": {
              "enum": [
                "account",
                "profile",
                "preferences",
                "photos",
                "facts_review",
                "calibration"
              ]
            },
            "profile_version": {
              "type": ["integer", "null"],
              "minimum": 1
            },
            "preferences_version": {
              "type": ["integer", "null"],
              "minimum": 1
            }
          }
        },
        "actor_account_id": {
          "type": "string",
          "format": "uuid"
        },
        "subject_account_id": {
          "type": "null"
        },
        "recommendation_batch_id": {
          "type": "null"
        },
        "recommendation_item_id": {
          "type": "null"
        },
        "match_id": {
          "type": "null"
        },
        "conversation_id": {
          "type": "null"
        },
        "producer": {
          "const": "api"
        }
      }
    }
  ]
}
