{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fact_reviewed.v1.json",
  "allOf": [
    {
      "$ref": "envelope.json"
    },
    {
      "type": "object",
      "properties": {
        "event_name": {
          "const": "fact_reviewed"
        },
        "schema_version": {
          "const": 1
        },
        "owner": {
          "const": "profiles"
        },
        "privacy_classification": {
          "const": "product_pseudonymous"
        },
        "properties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fact_id",
            "fact_category",
            "decision",
            "source_type"
          ],
          "properties": {
            "fact_id": {
              "type": "string",
              "format": "uuid"
            },
            "fact_category": {
              "enum": [
                "bio",
                "lifestyle",
                "intent",
                "other"
              ]
            },
            "decision": {
              "enum": [
                "accept",
                "edit",
                "reject"
              ]
            },
            "source_type": {
              "enum": [
                "extracted",
                "user_entered"
              ]
            },
            "extractor_version": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "actor_account_id": {
          "type": "string",
          "format": "uuid"
        },
        "subject_account_id": {
          "type": "null"
        },
        "recommendation_batch_id": {
          "type": "null"
        },
        "recommendation_item_id": {
          "type": "null"
        },
        "match_id": {
          "type": "null"
        },
        "conversation_id": {
          "type": "null"
        },
        "producer": {
          "const": "api"
        }
      }
    }
  ]
}
