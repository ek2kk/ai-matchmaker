{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "unmatch.v1.json",
  "allOf": [
    {
      "$ref": "envelope.json"
    },
    {
      "type": "object",
      "properties": {
        "event_name": {
          "const": "unmatch"
        },
        "schema_version": {
          "const": 1
        },
        "owner": {
          "const": "matching"
        },
        "privacy_classification": {
          "const": "product_pseudonymous"
        },
        "properties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "initiator_role",
            "match_age_seconds"
          ],
          "properties": {
            "initiator_role": {
              "const": "self"
            },
            "match_age_seconds": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "actor_account_id": {
          "type": "string",
          "format": "uuid"
        },
        "subject_account_id": {
          "type": "string",
          "format": "uuid"
        },
        "match_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    }
  ]
}
